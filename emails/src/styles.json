{
  "_comment": "Style macros: use as style=\"$name$\" inside templates/partials. Resolved at build time so every email is fully inlined.",
  "SANS": "'Inter',Arial,Helvetica,sans-serif",
  "MONO": "'JetBrains Mono',Consolas,'Courier New',monospace",
  "body": "margin:0;padding:0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#1F1F1F;mso-line-height-rule:exactly;",
  "p": "margin:0 0 16px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#1F1F1F;",
  "p-last": "margin:0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:15px;line-height:24px;color:#1F1F1F;",
  "lead": "margin:0 0 20px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;color:#1F1F1F;",
  "small": "margin:0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#5F6061;",
  "small-ink": "margin:0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#1F1F1F;",
  "h1": "margin:0 0 16px 0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:32px;line-height:34px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#1F1F1F;",
  "h1-white": "margin:0 0 16px 0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:32px;line-height:34px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#FFFFFF;",
  "h1-hero": "margin:0 0 20px 0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:40px;line-height:40px;font-weight:900;letter-spacing:-0.03em;text-transform:uppercase;color:#FFFFFF;",
  "h2": "margin:0 0 12px 0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:24px;line-height:26px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#1F1F1F;",
  "h2-white": "margin:0 0 12px 0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:24px;line-height:26px;font-weight:900;letter-spacing:-0.02em;text-transform:uppercase;color:#FFFFFF;",
  "h4": "margin:0 0 8px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#1F1F1F;",
  "h4-nomargin": "margin:0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:12px;line-height:18px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#1F1F1F;",
  "display-stat": "margin:0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:40px;line-height:40px;font-weight:900;letter-spacing:-0.03em;color:#1F1F1F;",
  "display-code": "margin:0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:36px;line-height:44px;font-weight:700;letter-spacing:0.12em;color:#1F1F1F;",
  "display-percent": "margin:0;font-family:'Inter','Arial Black',Arial,Helvetica,sans-serif;font-size:96px;line-height:88px;font-weight:900;letter-spacing:-0.05em;color:#FFFFFF;",
  "eyebrow": "margin:0 0 12px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#5F6061;",
  "eyebrow-red": "margin:0 0 12px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#C42A26;",
  "eyebrow-white": "margin:0 0 12px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#FFFFFF;opacity:0.8;",
  "eyebrow-light": "margin:0 0 12px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#BDBDBE;",
  "mono": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#1F1F1F;",
  "mono-sm": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:11px;line-height:16px;color:#5F6061;",
  "mono-lg": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:18px;line-height:24px;font-weight:700;color:#1F1F1F;",
  "price": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:18px;line-height:24px;font-weight:700;color:#1F1F1F;white-space:nowrap;",
  "price-old": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#7D7E7F;text-decoration:line-through;white-space:nowrap;",
  "price-red": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:18px;line-height:24px;font-weight:700;color:#C42A26;white-space:nowrap;",
  "link": "color:#C42A26;text-decoration:underline;",
  "link-mono": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:11px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#C42A26;text-decoration:none;",
  "link-mono-light": "font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#BDBDBE;text-decoration:none;",
  "th": "padding:0 0 10px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#7D7E7F;text-align:left;border-bottom:1px solid #D8D8D8;",
  "th-right": "padding:0 0 10px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#7D7E7F;text-align:right;border-bottom:1px solid #D8D8D8;",
  "td": "padding:14px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#1F1F1F;border-bottom:1px solid #EFEFEF;vertical-align:top;",
  "td-right": "padding:14px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#1F1F1F;border-bottom:1px solid #EFEFEF;text-align:right;vertical-align:top;white-space:nowrap;",
  "td-mono": "padding:14px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#1F1F1F;border-bottom:1px solid #EFEFEF;vertical-align:top;",
  "tot-label": "padding:6px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:13px;line-height:20px;color:#5F6061;text-align:right;",
  "tot-value": "padding:6px 0 6px 24px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:13px;line-height:20px;color:#1F1F1F;text-align:right;white-space:nowrap;",
  "tot-grand-label": "padding:12px 0 0 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#1F1F1F;text-align:right;border-top:1px solid #1F1F1F;",
  "tot-grand-value": "padding:12px 0 0 24px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:18px;line-height:24px;font-weight:700;color:#1F1F1F;text-align:right;border-top:1px solid #1F1F1F;white-space:nowrap;",
  "kv-key": "padding:8px 16px 8px 0;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#7D7E7F;vertical-align:top;white-space:nowrap;border-bottom:1px solid #EFEFEF;",
  "kv-val": "padding:8px 0;font-family:'Inter',Arial,Helvetica,sans-serif;font-size:14px;line-height:16px;color:#1F1F1F;vertical-align:top;border-bottom:1px solid #EFEFEF;",
  "section": "padding:32px 32px 8px 32px;",
  "section-tight": "padding:24px 32px 0 32px;",
  "section-last": "padding:24px 32px 40px 32px;",
  "cell": "padding:0 32px;",
  "badge-ok": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#15803D;background:#DCF5E6;",
  "badge-warn": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#B5811A;background:#FBF0D2;",
  "badge-danger": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#C42A26;background:#FDE3E2;",
  "badge-info": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#1F5F8B;background:#DCEAF4;",
  "badge-red": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#FFFFFF;background:#EA3E39;",
  "badge-ink": "display:inline-block;padding:4px 9px;font-family:'JetBrains Mono',Consolas,'Courier New',monospace;font-size:10px;line-height:14px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#FFFFFF;background:#1F1F1F;",
  "chamfer-red": "background-color:#EA3E39;background-image:linear-gradient(225deg,#FFFFFF 22px,#EA3E39 22px),linear-gradient(45deg,#FFFFFF 22px,#EA3E39 22px);background-position:top right,bottom left;background-size:51% 100%,51% 100%;background-repeat:no-repeat;",
  "chamfer-ink": "background-color:#1F1F1F;background-image:linear-gradient(225deg,#FFFFFF 22px,#1F1F1F 22px),linear-gradient(45deg,#FFFFFF 22px,#1F1F1F 22px);background-position:top right,bottom left;background-size:51% 100%,51% 100%;background-repeat:no-repeat;",
  "chamfer-red-on-concrete": "background-color:#EA3E39;background-image:linear-gradient(225deg,#D8D8D8 22px,#EA3E39 22px),linear-gradient(45deg,#D8D8D8 22px,#EA3E39 22px);background-position:top right,bottom left;background-size:51% 100%,51% 100%;background-repeat:no-repeat;",
  "chamfer-concrete": "background-color:#D8D8D8;background-image:linear-gradient(225deg,#FFFFFF 22px,#D8D8D8 22px),linear-gradient(45deg,#FFFFFF 22px,#D8D8D8 22px);background-position:top right,bottom left;background-size:51% 100%,51% 100%;background-repeat:no-repeat;",
  "chamfer-ink-on-dark": "background-color:#1F1F1F;background-image:linear-gradient(225deg,#111111 22px,#1F1F1F 22px),linear-gradient(45deg,#111111 22px,#1F1F1F 22px);background-position:top right,bottom left;background-size:51% 100%,51% 100%;background-repeat:no-repeat;",
  "rule": "font-size:0;line-height:0;height:1px;background:#D8D8D8;",
  "rule-ink": "font-size:0;line-height:0;height:1px;background:#1F1F1F;",
  "spacer": "font-size:0;line-height:0;"
}

# Copy to .env and fill in. Never commit .env (.gitignore covers .env*).

# ─── Where this site lives ──────────────────────────────────────────────────
# The one place the public domain is written down. It is what share previews,
# canonical links and any absolute URL resolve against, and what HDCtool's
# change feed is pointed at. Production: https://web.kolleris.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google (Merchant Center, Search Console) ───────────────────────────────
# Merchant Center account for the product feed at /feeds/google-merchant.xml.
# Recorded rather than used: the feed is pulled by Google on a schedule set in
# the Merchant Center account, so nothing here needs the number. It is written
# down so the next person knows which account the feed belongs to.
GOOGLE_MERCHANT_ID=522915672
# Overrides the Search Console verification token compiled into the layout.
# Only needed for a second property or a staging domain — the production token
# is in the source, because it is published in the page for anyone to read.
GOOGLE_SITE_VERIFICATION=

# ─── Agentic Commerce Protocol (AI agents) ──────────────────────────────────
# Comma-separated key:name pairs. The name is what makes "who pulled the whole
# catalogue" answerable in a log, and lets one agent be cut off on its own.
#   ACP_API_KEYS=k_live_abc:openai,k_live_def:deepseek
# Unset = /api/acp/* answers 503 and nothing is exposed.
ACP_API_KEYS=

# ─── Database (PostgreSQL 16) ───────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/kolshop

# ─── Auth.js (JWT session strategy, RBAC for /admin) ────────────────────────
AUTH_SECRET=            # openssl rand -base64 32
AUTH_TRUST_HOST=true

# AUTH_URL — LEAVE UNSET behind a reverse proxy, which is every deployment.
#
# It is not a convenience setting. NextAuth rebases the request origin on it, so
# next-intl's rewrite of `/` to `/el` becomes an absolute URL on whatever origin
# is written here. If that is not exactly the origin being served, Next treats
# its own rewrite as an external address and tries to proxy it: the entire Greek
# storefront returns 500 and `/` redirects to itself forever.
#
# It is silent in development, where the value happens to be right, and total in
# production, where it is not. With AUTH_TRUST_HOST=true the origin is read from
# the proxy's headers and cannot be wrong. Set this only for a deployment with
# no proxy, and then to the exact public origin.
# AUTH_URL=https://web.kolleris.com

# ─── HDCtool (PIM / ERP integration) ────────────────────────────────────────
HDCTOOL_BASE_URL=https://hdctool.wwa.gr
HDCTOOL_API_KEY=
HDCTOOL_AUTH_EMAIL=
HDCTOOL_AUTH_PASSWORD=
# Shared with HDCtool's ESHOP_WEBHOOK_SECRET. Signs the change feed (HMAC-SHA256
# over the raw bytes). Without it /api/webhooks/hdctool answers 503 and HDCtool
# keeps the changes queued.
HDCTOOL_WEBHOOK_SECRET=

# ─── DeepSeek (translations el → en/it) ─────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ─── i18n ───────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=el
SUPPORTED_LOCALES=el,en,it

# ─── ACS Courier ────────────────────────────────────────────────────────────
ACS_API_KEY=
ACS_COMPANY_ID=
ACS_COMPANY_PASSWORD=
ACS_USER_ID=
ACS_USER_PASSWORD=
ACS_BILLING_CODE=

# ─── Viva Wallet ────────────────────────────────────────────────────────────
VIVA_ENVIRONMENT=demo          # demo | production
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
VIVA_WEBHOOK_VERIFICATION_KEY=

# Claid.ai — background removal for banner imagery
CLAID_API_KEY=

# ─── Maps & addresses ───────────────────────────────────────────────────────
# Server-side only. The static map and the checkout address suggestions both
# go through MapTiler; nothing reaches the browser.
MAPTILER_API_KEY=
GEOCODE_API=
GOOGLE_MAPS_API_KEY=
